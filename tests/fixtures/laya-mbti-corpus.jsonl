{"id": "train-jp-insufficient-03", "text": "验证码 6248，五分钟内有效", "axis": "JP", "label": "insufficient", "split": "train"}
{"id": "train-jp-insufficient-04", "text": "门禁卡在抽屉第二层", "axis": "JP", "label": "insufficient", "split": "train"}
